MONGODB_URI=mongodb://username:password@localhost:27017/cynosure?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
PORT=4100
CORS_ORIGIN=http://localhost:4101,http://localhost:4102
UPLOADS_DIR=./uploads

# Customer app invite emails (Resend). Without RESEND_API_KEY nothing is emailed and staff are
# shown the set-password link to pass on themselves.
RESEND_API_KEY=
MAIL_FROM=Cynosure <onboarding@resend.dev>
CUSTOMER_APP_URL=http://localhost:4101
